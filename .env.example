# NextAuth Configuration
# Generate AUTH_SECRET with: openssl rand -base64 32
# A production server refuses to run with the placeholder below.
AUTH_SECRET=your-secret-key-here

# Google OAuth Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a new project (or pick an existing one)
# 2. Configure the OAuth consent screen (Google Auth Platform > Branding/Audience)
# 3. Create an OAuth 2.0 Client ID of type "Web application"
# 4. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
#    (and production: https://your-app.example.com/api/auth/callback/google)
# Step by step: SELF_HOSTING.md
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# NextAuth URL
# Development: http://localhost:3000
# Production: https://your-app.example.com
NEXTAUTH_URL=http://localhost:3000

# Trust host (required for some deployments)
AUTH_TRUST_HOST=true

# PostgreSQL connection string
# Local dev: docker run -d --name genealogy-pg -e POSTGRES_PASSWORD=password -e POSTGRES_DB=genealogy_dev -p 5432:5432 postgres:16-alpine
# Railway: Auto-provided by PostgreSQL plugin
DATABASE_URL=postgresql://postgres:password@localhost:5432/genealogy_dev

# Data directory for media uploads
# Default: ./data (relative to project root)
# Railway: Set to persistent volume mount path (e.g., /data)
# DATA_DIR=/data

# Optional: per-tree media storage limit in bytes on the hosted server.
# Default: 104857600 (100 MB). The static and desktop builds ignore it.
# MEDIA_TREE_QUOTA_BYTES=524288000

# Who may sign in lives in the database (Members page, admins only). The bootstrap
# address becomes the first admin whenever there is no admin. Hosted production
# with no members and no bootstrap address lets nobody in; local development with
# neither stays open. Static/Tauri builds have no OAuth server.
# Do not commit real family addresses to this file.
# AUTH_BOOTSTRAP_EMAIL=you@example.com
#
# Legacy allowlist: read once, on the first hosted startup with the Members table,
# to seed members. Remove it after that startup.
# AUTH_ALLOWED_EMAILS=you@example.com,partner@example.com

# Optional: enable Google Drive manual backup/restore in the STATIC build only
# (dev:static / Cloudflare / Tauri desktop — the hosted PostgreSQL build ignores
# it entirely). When unset (the default), the Drive UI never renders and no
# Google Cloud setup is needed; file-based backup/restore keeps working.
# This is an OAuth *client ID* — a public identifier, not a secret (hence
# NEXT_PUBLIC_). Setup walkthrough: docs/drive-backup-setup.md
# NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# Optional: emit chatty operational logs (pool lifecycle, schema init, user
# provisioning) to stdout. Off by default so production stays quiet and never
# logs user emails. Set to true only when debugging.
# DEBUG_LOGS=true

# Optional: MapLibre basemap style URLs. Default: OpenFreeMap (no API key).
# The dark style falls back to the light one when only that is set.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# NEXT_PUBLIC_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark

# Optional, read at build time: the About page's "Source code" link (#1256). Set it
# to your fork if you change the code and run it for other people (AGPL-3.0).
# Unset links the upstream repository. HEIRLOOM_HOSTED=true makes About say "Hosted server".
# SOURCE_URL=https://example.org/you/heirloom
# HEIRLOOM_HOSTED=true

# Optional, static build only: serve the site from a subpath instead of the
# domain root, e.g. /heirloom. Default: empty.
# NEXT_PUBLIC_BASE_PATH=

# Optional, development only: extra hosts allowed to load dev resources and HMR,
# comma-separated (e.g. when testing from a phone on your LAN).
# DEV_ALLOWED_ORIGINS=192.168.1.20
