{
  "name": "genealogy-nextjs",
  "version": "0.23.2",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "maplibre:copy-worker": "node scripts/copy-maplibre-worker.mjs",
    "predev": "npm run maplibre:copy-worker && npm run licenses:third-party",
    "dev": "next dev",
    "predev:webpack": "npm run maplibre:copy-worker",
    "dev:webpack": "NEXT_PRIVATE_DISABLE_TURBOPACK=1 next dev",
    "predev:static": "npm run maplibre:copy-worker && npm run licenses:third-party",
    "dev:static": "cross-env BUILD_TARGET=static NEXT_PUBLIC_DATA_MODE=local next dev -p 3010",
    "dev:clean": "node scripts/dev-clean.mjs",
    "dev:static:clean": "node scripts/dev-clean.mjs static",
    "backup:railway": "bash scripts/backup-railway.sh",
    "licenses:third-party": "node scripts/third-party-licenses.mjs",
    "prebuild": "npm run maplibre:copy-worker && npm run licenses:third-party",
    "build": "next build",
    "prebuild:static": "npm run maplibre:copy-worker && npm run licenses:third-party",
    "build:static": "cross-env BUILD_TARGET=static NEXT_PUBLIC_DATA_MODE=local node scripts/build-static.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:ds": "eslint app -c eslint.ds-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:media-thumbnails": "vitest run --config vitest.benchmark.config.ts --reporter=verbose scripts/benchmark-media-thumbnails",
    "benchmark:media-hero": "cross-env MEDIA_BENCHMARK_SIZE=2048 vitest run --config vitest.benchmark.config.ts --reporter=verbose scripts/benchmark-media-thumbnails",
    "benchmark:services": "vitest run --config vitest.benchmark.config.ts scripts/perf/bench-services",
    "test:unit": "vitest run __tests__/unit/ --fileParallelism --maxWorkers=2",
    "test:fast": "vitest run __tests__/unit/ --exclude \"**/*.pglite.test.ts\" --exclude \"**/ui-render.test.tsx\" --exclude \"**/{DriveBackupSection,BackupPanel,BackupStatusChip,BackupNudge}*.test.tsx\" --fileParallelism",
    "test:integration": "vitest run __tests__/integration/",
    "test:integration:pglite": "vitest run --config vitest.pglite.config.ts --maxWorkers=4",
    "db:test:up": "docker compose up -d --wait",
    "db:test:down": "docker compose down",
    "verify": "node scripts/verify.mjs",
    "test:integration:local": "npm run db:test:up && npm run test:integration",
    "browser:install": "playwright install chromium-headless-shell",
    "test:a11y:scan": "node scripts/a11y-contrast-scan.mjs",
    "test:layout:scan": "node scripts/page-shell-scan.mjs",
    "test:focus:scan": "node scripts/focus-ring-scan.mjs",
    "test:mobile:scan": "node scripts/mobile-person-scan.mjs",
    "test:a11y": "npm run build:static && npm run test:a11y:scan && npm run test:layout:scan && npm run test:focus:scan && npm run test:mobile:scan",
    "test:static-import": "npm run build:static && node scripts/static-gedcom-import-check.mjs",
    "doctor:test-tooling": "node scripts/check-test-toolchain.mjs",
    "db:query": "tsx --env-file=.env.local scripts/db-query.ts",
    "db:query:test": "tsx --env-file=.env.test.local scripts/db-query.ts",
    "backfill:media-thumbnails": "tsx --env-file=.env.local scripts/backfill-media-thumbnails.ts",
    "audit:names": "tsx --env-file=.env.local scripts/audit-name-variants.ts",
    "audit:names:test": "tsx --env-file=.env.test.local scripts/audit-name-variants.ts",
    "audit:media-links": "tsx --env-file=.env.local scripts/audit-media-links-cli.ts",
    "audit:invariants": "tsx --env-file-if-exists=.env.local scripts/audit/invariant-sweep-cli.ts",
    "audit:gedcom-interop": "vitest run --config vitest.interop.config.ts --reporter=dot",
    "sweep:orphan-media": "node --env-file=.env.local scripts/sweep-orphan-media.mjs",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed:synthetic": "tsx --env-file=.env.local scripts/seed-synthetic-data.ts hosted",
    "fixture:synthetic": "tsx scripts/seed-synthetic-data.ts static",
    "fixture:synthetic:verify": "tsx scripts/seed-synthetic-data.ts verify --input test-fixtures/synthetic.hlbak",
    "db:seed:audit-review": "tsx --env-file=.env.local scripts/seed-audit-review.ts hosted",
    "fixture:audit-review": "tsx scripts/seed-audit-review.ts static",
    "fixture:large-gedcom": "node scripts/ux-audit/gen-large-gedcom.mjs",
    "db:assign": "tsx scripts/assign-existing-data.ts",
    "postinstall": "npm run db:init",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "audit:artifacts": "node scripts/audit/run-all.mjs",
    "audit:knip": "knip",
    "audit:knip:ci": "node scripts/audit/knip-ratchet.mjs",
    "audit:knip:update": "node scripts/audit/knip-ratchet.mjs --update"
  },
  "dependencies": {
    "@auth/core": "^0.41.0",
    "@electric-sql/pglite": "^0.4.6",
    "@electric-sql/pglite-tools": "^0.3.6",
    "@serwist/next": "^9.5.11",
    "@swc/helpers": "^0.5.20",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "archiver": "^7.0.1",
    "d3-hierarchy": "^3.1.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^1.18.0",
    "maplibre-gl": "^6.9.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.8.3",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.13.0",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "reactflow": "^11.11.4",
    "serwist": "^9.5.11",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^7.0.0",
    "@types/node": "^24",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.0.0",
    "knip": "^6.17.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^8.0.2",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "sharp@0.35.4": true,
    "unrs-resolver@1.11.1": true,
    "@swc/core@1.16.2": true,
    "esbuild@0.27.2": true
  },
  "overrides": {
    "browserslist": "4.28.7",
    "uuid": "11.1.1",
    "exceljs": {
      "unzipper": "^0.12.5"
    }
  }
}
