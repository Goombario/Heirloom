# Enforce the `engines` floors in package.json as hard errors, not warnings.
#
# Without this, an npm older than 11.16.0 silently prunes nested WASM optional
# deps (@emnapi/{core,runtime} under the *-wasm32-wasi packages) when it
# regenerates package-lock.json, producing a lockfile CI's `npm ci` rejects with
# `EUSAGE ... Missing: @emnapi/core@1.10.0 from lock file`. npm 11.6.2 does this;
# 11.16.0+ does not. See docs/superpowers/CONTINUE-HERE.md.
engine-strict=true
